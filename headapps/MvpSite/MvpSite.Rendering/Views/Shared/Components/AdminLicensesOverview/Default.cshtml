@using Mvp.Selections.Domain
@model MvpSite.Rendering.Models.Admin.LicenseOverviewModel

<div class="mvp-fs-adminlicensesoverview col-12 bg-white">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 asp-for="TitleLabel" class="mb-0"></h2>
        <a asp-for="UploadLicensesLink" href="@Model.UploadLicensesLink?.Value?.Href" class="btn btn-primary" role="button">
            <i class="fa fa-upload" aria-hidden="true"></i> @Model.UploadLicensesLink?.Value?.Text
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th asp-for="AssignedUserNameHeader" scope="col"></th>
                <th asp-for="ExpirationDateHeader" scope="col"></th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (License license in Model.List)
            {
                <tr>
                    <td>
                        @if (string.IsNullOrEmpty(license.AssignedUser?.Name))
                        {
                            @(Model.IsEditing? Html.Raw(Model.UnAssignedUserLabel?.EditableMarkup) : Model.UnAssignedUserLabel?.Value)
                        }
                        else
                        {
                            @license.AssignedUser.Name
                        }
                    </td>
                    <td>@license.ExpirationDate.ToString("d")</td>
                    <td>
                        <a asp-for="EditLink"
                           href="@Model.EditLink?.Value.Href?id=@license.Id"
                           class="btn btn-secondary"><i class="fa fa-pencil" aria-hidden="true"></i>@Model.EditLink?.Value?.Text</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Paging" />
</div>